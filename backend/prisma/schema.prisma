// OASIS ONE Database Schema — MySQL 8 (Prisma ORM)
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum AccountStatus {
  pending_verification
  pending_approval
  active
  suspended
  revoked
  blacklisted
  deactivated
}

enum ApplicationStatus {
  not_started
  pending
  approved
  rejected
  info_requested
  withdrawn
}

enum UserRole {
  aspiring_entrepreneur
  founder
  mentor
}

enum AdminLevel {
  super_admin
  moderator
}

enum AuthorType {
  admin
  applicant
}

enum LegalDocType {
  privacy_notice
  community_guidelines
}

enum PostType {
  question
  suggestion
  resource
  opportunity
}

enum PostStatus {
  published
  hidden
  deleted
}

enum AchievementStatus {
  pending_review
  approved
  rejected
  expired
  archived
}

enum ConnectionStatus {
  pending
  accepted
  declined
  expired
  cancelled
}

enum EventVisibility {
  all_members
  specific_roles
  invite_only
}

enum EventStatus {
  draft
  published
  cancelled
  archived
  completed
}

enum RegistrationStatus {
  registered
  waitlisted
  cancelled
  promoted
}

enum TaskPriority {
  low
  normal
  high
}

enum TaskStatus {
  open
  completed
  archived
}

enum TaskKind {
  task
  deadline
}

enum NotificationDeliveryChannel {
  in_app
  email
  both
}

enum DeliveryStatus {
  pending
  sent
  failed
  bounced
}

enum ReportTargetType {
  post
  response
  achievement
  profile
}

enum ReportReasonCategory {
  spam
  harassment
  misinformation
  other
}

enum ReportStatus {
  pending
  reviewed
  resolved
  dismissed
}

enum RestrictionType {
  warning
  suspension
  revocation
  blacklist
}

enum TagStatus {
  active
  retired
}

enum TagCategory {
  sector
  expertise
  general
}

enum InviteStatus {
  pending
  used
  expired
}

enum JobStatus {
  pending
  processing
  completed
  failed
  dead_letter
}

enum FilePurpose {
  profile_photo
  achievement_media
  application_attachment
  verification_evidence
  export_download
}

enum FileScanStatus {
  pending
  clean
  infected
  skipped
}

enum VerificationTokenType {
  email_verify
  password_reset
  email_change
  set_password
}

// ----------------------------------------------------
// CORE USER & AUTH MODELS
// ----------------------------------------------------

model User {
  id                     String         @id @default(uuid()) @db.Char(36)
  email                  String         @unique @db.VarChar(255)
  passwordHash           String?        @map("password_hash") @db.VarChar(255)
  primaryRole            UserRole?      @map("primary_role")
  additionalRoles        Json?          @map("additional_roles")
  adminLevel             AdminLevel?    @map("admin_level")
  accountStatus          AccountStatus  @default(pending_verification) @map("account_status")
  emailVerified          Boolean        @default(false) @map("email_verified")
  phone                  String?        @db.VarChar(50)
  phoneVerifiedAt        DateTime?      @map("phone_verified_at") @db.DateTime(3)
  mfaEnabled             Boolean        @default(false) @map("mfa_enabled")
  mfaSecret              String?        @map("mfa_secret") @db.VarChar(512)
  mfaBackupCodes         Json?          @map("mfa_backup_codes")
  unlockAnimationPending Boolean        @default(false) @map("unlock_animation_pending")
  timeZone               String         @default("Asia/Kolkata") @map("time_zone") @db.VarChar(100)
  lastLoginAt            DateTime?      @map("last_login_at") @db.DateTime(3)
  createdAt              DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.DateTime(3)

  // Relations
  sessions               Session[]
  identities             AuthIdentity[]
  profile                Profile?
  applications           Application[]          @relation("ApplicantApplications")
  claimedApplications    Application[]          @relation("ReviewerClaims")
  decidedApplications    Application[]          @relation("ReviewerDecisions")
  applicationMessages    ApplicationMessage[]
  consentRecords         ConsentRecord[]
  posts                  Post[]
  postResponses          PostResponse[]
  achievements           Achievement[]
  sentConnections        ConnectionRequest[]    @relation("SentConnections")
  receivedConnections    ConnectionRequest[]    @relation("ReceivedConnections")
  blockedUsers           MemberBlock[]          @relation("Blocker")
  blockedBy              MemberBlock[]          @relation("Blocked")
  eventRegistrations     EventRegistration[]
  createdEvents          Event[]                @relation("CreatedEvents")
  eventInvitations       EventInvitee[]
  tasks                  Task[]
  notificationDeliveries NotificationDelivery[]
  notificationPreferences NotificationPreference[]
  contentReports         ContentReport[]        @relation("Reporter")
  resolvedReports        ContentReport[]        @relation("ReportResolver")
  restrictions           Restriction[]          @relation("UserRestrictions")
  issuedRestrictions     Restriction[]          @relation("AdminRestrictions")
  resolvedRestrictions   Restriction[]          @relation("RestrictionResolver")
  auditLogs              AuditLog[]
  profileChangeRequests  ProfileChangeRequest[]
  pushSubscriptions      PushSubscription[]
  dataExportRequests     DataExportRequest[]
  deletionRequests       DeletionRequest[]
  uploadedFiles          UploadedFile[]
  startupMemberships     StartupMember[]
  createdStartups        Startup[]              @relation("StartupCreator")
  usedInviteLinks        InviteLink[]           @relation("InviteRegisteredUser")

  @@index([accountStatus])
  @@index([primaryRole])
  @@index([adminLevel])
  @@index([createdAt])
  @@map("users")
}

model Session {
  id           String   @id @default(uuid()) @db.Char(36)
  userId       String   @map("user_id") @db.Char(36)
  tokenHash    String   @unique @map("token_hash") @db.VarChar(64)
  mfaVerified  Boolean  @default(false) @map("mfa_verified")
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.Text
  lastActiveAt DateTime @default(now()) @map("last_active_at") @db.DateTime(3)
  expiresAt    DateTime @map("expires_at") @db.DateTime(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthIdentity {
  id             String   @id @default(uuid()) @db.Char(36)
  userId         String   @map("user_id") @db.Char(36)
  provider       String   @db.VarChar(50)
  providerUserId String   @map("provider_user_id") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

model VerificationToken {
  id        String                @id @default(uuid()) @db.Char(36)
  userId    String?               @map("user_id") @db.Char(36)
  email     String                @db.VarChar(255)
  tokenHash String                @unique @map("token_hash") @db.VarChar(64)
  type      VerificationTokenType
  metadata  Json?
  expiresAt DateTime              @map("expires_at") @db.DateTime(3)
  usedAt    DateTime?             @map("used_at") @db.DateTime(3)
  createdAt DateTime              @default(now()) @map("created_at") @db.DateTime(3)

  @@index([email])
  @@index([expiresAt])
  @@map("verification_tokens")
}

model PhoneVerification {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  phone     String   @db.VarChar(50)
  otpHash   String   @map("otp_hash") @db.VarChar(64)
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at") @db.DateTime(3)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([userId])
  @@index([phone])
  @@map("phone_verifications")
}

// ----------------------------------------------------
// APPLICATION & ONBOARDING
// ----------------------------------------------------

model Application {
  id                      String            @id @default(uuid()) @db.Char(36)
  userId                  String            @map("user_id") @db.Char(36)
  submittedProfileSnapshot Json             @map("submitted_profile_snapshot")
  status                  ApplicationStatus @default(pending)
  expedited               Boolean           @default(false)
  canReapplyAt            DateTime?         @map("can_reapply_at") @db.DateTime(3)
  submittedAt             DateTime          @default(now()) @map("submitted_at") @db.DateTime(3)
  reviewedBy              String?           @map("reviewed_by") @db.Char(36)
  claimedBy               String?           @map("claimed_by") @db.Char(36)
  claimedAt               DateTime?         @map("claimed_at") @db.DateTime(3)
  reviewedAt              DateTime?         @map("reviewed_at") @db.DateTime(3)
  decisionReason          String?           @map("decision_reason") @db.Text
  decisionRubric          Json?             @map("decision_rubric")
  createdAt               DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.DateTime(3)

  user     User                 @relation("ApplicantApplications", fields: [userId], references: [id], onDelete: Cascade)
  claimant User?                @relation("ReviewerClaims", fields: [claimedBy], references: [id], onDelete: SetNull)
  reviewer User?                @relation("ReviewerDecisions", fields: [reviewedBy], references: [id], onDelete: SetNull)
  messages ApplicationMessage[]

  @@index([userId])
  @@index([status])
  @@index([claimedBy])
  @@index([claimedAt])
  @@index([submittedAt])
  @@map("applications")
}

model ApplicationMessage {
  id             String      @id @default(uuid()) @db.Char(36)
  applicationId  String      @map("application_id") @db.Char(36)
  authorId       String      @map("author_id") @db.Char(36)
  authorType     AuthorType  @map("author_type")
  body           String      @db.Text
  attachments    Json?
  isInternalNote Boolean     @default(false) @map("is_internal_note")
  createdAt      DateTime    @default(now()) @map("created_at") @db.DateTime(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([authorId])
  @@index([isInternalNote])
  @@map("application_messages")
}

// ----------------------------------------------------
// LEGAL & CONSENT
// ----------------------------------------------------

model LegalDocument {
  id          String       @id @default(uuid()) @db.Char(36)
  type        LegalDocType
  version     String       @db.VarChar(50)
  title       String       @db.VarChar(255)
  body        String       @db.MediumText
  isCurrent   Boolean      @default(false) @map("is_current")
  publishedAt DateTime     @default(now()) @map("published_at") @db.DateTime(3)
  publishedBy String?      @map("published_by") @db.Char(36)

  @@unique([type, version])
  @@index([type, isCurrent])
  @@map("legal_documents")
}

model ConsentRecord {
  id              String       @id @default(uuid()) @db.Char(36)
  userId          String       @map("user_id") @db.Char(36)
  documentType    LegalDocType @map("document_type")
  documentVersion String       @map("document_version") @db.VarChar(50)
  acceptedAt      DateTime     @default(now()) @map("accepted_at") @db.DateTime(3)
  ipAddress       String?      @map("ip_address") @db.VarChar(45)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([documentType, documentVersion])
  @@map("consent_records")
}

// ----------------------------------------------------
// PROFILES, TAXONOMY, STARTUPS
// ----------------------------------------------------

model Profile {
  id                     String    @id @default(uuid()) @db.Char(36)
  userId                 String    @unique @map("user_id") @db.Char(36)
  name                   String    @db.VarChar(255)
  headline               String?   @db.VarChar(255)
  bio                    String?   @db.Text
  city                   String?   @db.VarChar(100)
  state                  String?   @db.VarChar(100)
  country                String?   @default("India") @db.VarChar(100)
  profilePhotoUrl        String?   @map("profile_photo_url") @db.VarChar(1024)
  photoFileId            String?   @map("photo_file_id") @db.Char(36)
  linkedinUrl            String?   @map("linkedin_url") @db.VarChar(512)
  twitterUrl             String?   @map("twitter_url") @db.VarChar(512)
  githubUrl              String?   @map("github_url") @db.VarChar(512)
  websiteUrl             String?   @map("website_url") @db.VarChar(512)
  mentorVerified         Boolean   @default(false) @map("mentor_verified")
  mentorAvailability     String    @default("active") @map("mentor_availability") @db.VarChar(50)
  maxMentees             Int?      @map("max_mentees")
  preferredContactMethod String?   @map("preferred_contact_method") @db.VarChar(100)
  visibilitySettings     Json?     @map("visibility_settings")
  contactPreferences     Json?     @map("contact_preferences")
  roleAttributes         Json?     @map("role_attributes")
  createdAt              DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags  ProfileTag[]

  @@fulltext([name, bio, headline])
  @@index([city])
  @@index([mentorVerified])
  @@index([mentorAvailability])
  @@map("profiles")
}

model ProfileChangeRequest {
  id            String    @id @default(uuid()) @db.Char(36)
  userId        String    @map("user_id") @db.Char(36)
  fieldKey      String    @map("field_key") @db.VarChar(100)
  currentValue  Json?     @map("current_value")
  proposedValue Json      @map("proposed_value")
  status        String    @default("pending") @db.VarChar(50) // pending | approved | rejected
  reviewedBy    String?   @map("reviewed_by") @db.Char(36)
  reviewedAt    DateTime? @map("reviewed_at") @db.DateTime(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("profile_change_requests")
}

model ExpertiseTag {
  id        String       @id @default(uuid()) @db.Char(36)
  name      String       @unique @db.VarChar(100)
  category  TagCategory  @default(general)
  status    TagStatus    @default(active)
  createdBy String?      @map("created_by") @db.Char(36)
  createdAt DateTime     @default(now()) @map("created_at") @db.DateTime(3)

  profiles  ProfileTag[]
  posts     PostTag[]
  events    EventTag[]

  @@index([category])
  @@index([status])
  @@map("expertise_tags")
}

model ProfileTag {
  profileId String @map("profile_id") @db.Char(36)
  tagId     String @map("tag_id") @db.Char(36)

  profile Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tag     ExpertiseTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([profileId, tagId])
  @@index([tagId])
  @@map("profile_tags")
}

model Startup {
  id             String   @id @default(uuid()) @db.Char(36)
  name           String   @unique @db.VarChar(255)
  industry       String?  @db.VarChar(100)
  stage          String?  @db.VarChar(50) // idea | mvp | early_revenue | scaling
  productSummary String?  @map("product_summary") @db.Text
  website        String?  @db.VarChar(512)
  location       String?  @db.VarChar(100)
  createdBy      String   @map("created_by") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  creator User            @relation("StartupCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  members StartupMember[]

  @@index([name])
  @@map("startups")
}

model StartupMember {
  id            String  @id @default(uuid()) @db.Char(36)
  startupId     String  @map("startup_id") @db.Char(36)
  userId        String  @map("user_id") @db.Char(36)
  roleInStartup String? @map("role_in_startup") @db.VarChar(100)

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([startupId, userId])
  @@index([userId])
  @@map("startup_members")
}

// ----------------------------------------------------
// POSTS, RESPONSES, ACHIEVEMENTS
// ----------------------------------------------------

model Post {
  id               String       @id @default(uuid()) @db.Char(36)
  authorId         String       @map("author_id") @db.Char(36)
  type             PostType     @default(question)
  title            String       @db.VarChar(200)
  body             String       @db.MediumText
  category         String       @default("Question") @db.VarChar(100)
  status           PostStatus   @default(published)
  isResolved       Boolean      @default(false) @map("is_resolved")
  resolvedAnswerId String?      @map("resolved_answer_id") @db.Char(36)
  originalBody     String?      @map("original_body") @db.MediumText
  editedAt         DateTime?    @map("edited_at") @db.DateTime(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  responses PostResponse[]
  tags      PostTag[]

  @@fulltext([title, body])
  @@index([authorId])
  @@index([status])
  @@index([type])
  @@index([category])
  @@index([createdAt])
  @@map("posts")
}

model PostTag {
  postId String @map("post_id") @db.Char(36)
  tagId  String @map("tag_id") @db.Char(36)

  post Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  ExpertiseTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tags")
}

model PostResponse {
  id        String     @id @default(uuid()) @db.Char(36)
  postId    String     @map("post_id") @db.Char(36)
  authorId  String     @map("author_id") @db.Char(36)
  body      String     @db.Text
  status    PostStatus @default(published)
  createdAt DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
  @@index([status])
  @@index([createdAt])
  @@map("post_responses")
}

model Achievement {
  id              String            @id @default(uuid()) @db.Char(36)
  authorId        String            @map("author_id") @db.Char(36)
  title           String            @db.VarChar(255)
  description     String            @db.Text
  mediaUrl        String?           @map("media_url") @db.VarChar(1024)
  mediaType       String?           @map("media_type") @db.VarChar(50)
  status          AchievementStatus @default(pending_review)
  submittedAt     DateTime          @default(now()) @map("submitted_at") @db.DateTime(3)
  approvedAt      DateTime?         @map("approved_at") @db.DateTime(3)
  expiresAt       DateTime?         @map("expires_at") @db.DateTime(3)
  rejectionReason String?           @map("rejection_reason") @db.Text
  createdAt       DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.DateTime(3)

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([status])
  @@index([approvedAt])
  @@index([expiresAt])
  @@map("achievements")
}

// ----------------------------------------------------
// CONNECTIONS & BLOCKS
// ----------------------------------------------------

model ConnectionRequest {
  id          String           @id @default(uuid()) @db.Char(36)
  senderId    String           @map("sender_id") @db.Char(36)
  recipientId String           @map("recipient_id") @db.Char(36)
  message     String?          @db.Text
  status      ConnectionStatus @default(pending)
  createdAt   DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  respondedAt DateTime?        @map("responded_at") @db.DateTime(3)
  expiresAt   DateTime         @map("expires_at") @db.DateTime(3)

  sender    User @relation("SentConnections", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("ReceivedConnections", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([recipientId])
  @@index([status])
  @@index([expiresAt])
  @@map("connection_requests")
}

model MemberBlock {
  id        String   @id @default(uuid()) @db.Char(36)
  blockerId String   @map("blocker_id") @db.Char(36)
  blockedId String   @map("blocked_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("member_blocks")
}

// ----------------------------------------------------
// EVENTS & CALENDAR
// ----------------------------------------------------

model Event {
  id                   String          @id @default(uuid()) @db.Char(36)
  title                String          @db.VarChar(255)
  description          String          @db.MediumText
  startAt              DateTime        @map("start_at") @db.DateTime(3)
  endAt                DateTime        @map("end_at") @db.DateTime(3)
  venueOrLink          String?         @map("venue_or_link") @db.VarChar(512)
  meetingLink          String?         @map("meeting_link") @db.VarChar(512)
  capacity             Int?
  waitlistEnabled      Boolean         @default(true) @map("waitlist_enabled")
  registrationDeadline DateTime?       @map("registration_deadline") @db.DateTime(3)
  visibility           EventVisibility @default(all_members)
  visibleToRoles       Json?           @map("visible_to_roles")
  status               EventStatus     @default(draft)
  createdBy            String          @map("created_by") @db.Char(36)
  createdAt            DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.DateTime(3)

  creator       User                @relation("CreatedEvents", fields: [createdBy], references: [id], onDelete: Cascade)
  formFields    EventFormField[]
  registrations EventRegistration[]
  tags          EventTag[]
  invitees      EventInvitee[]

  @@fulltext([title, description])
  @@index([startAt])
  @@index([status])
  @@index([visibility])
  @@index([createdBy])
  @@map("events")
}

model EventFormField {
  id           String  @id @default(uuid()) @db.Char(36)
  eventId      String  @map("event_id") @db.Char(36)
  fieldLabel   String  @map("field_label") @db.VarChar(255)
  fieldType    String  @map("field_type") @db.VarChar(50) // text | textarea | select | radio | checkbox
  required     Boolean @default(false)
  options      Json?   // options for select/radio
  displayOrder Int     @default(0) @map("display_order")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_form_fields")
}

model EventRegistration {
  id               String             @id @default(uuid()) @db.Char(36)
  eventId          String             @map("event_id") @db.Char(36)
  userId           String             @map("user_id") @db.Char(36)
  responses        Json?
  status           RegistrationStatus @default(registered)
  waitlistPosition Int?               @map("waitlist_position")
  checkedInAt      DateTime?          @map("checked_in_at") @db.DateTime(3)
  registeredAt     DateTime           @default(now()) @map("registered_at") @db.DateTime(3)
  cancelledAt      DateTime?          @map("cancelled_at") @db.DateTime(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId, status])
  @@map("event_registrations")
}

model EventTag {
  eventId String @map("event_id") @db.Char(36)
  tagId   String @map("tag_id") @db.Char(36)

  event Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tag   ExpertiseTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([eventId, tagId])
  @@index([tagId])
  @@map("event_tags")
}

model EventInvitee {
  id      String @id @default(uuid()) @db.Char(36)
  eventId String @map("event_id") @db.Char(36)
  userId  String @map("user_id") @db.Char(36)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_invitees")
}

// ----------------------------------------------------
// TASKS
// ----------------------------------------------------

model Task {
  id         String       @id @default(uuid()) @db.Char(36)
  ownerId    String       @map("owner_id") @db.Char(36)
  title      String       @db.VarChar(200)
  notes      String?      @db.Text
  kind       TaskKind     @default(task)
  dueAt      DateTime?    @map("due_at") @db.DateTime(3)
  priority   TaskPriority @default(normal)
  status     TaskStatus   @default(open)
  reminderAt DateTime?    @map("reminder_at") @db.DateTime(3)
  createdAt  DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([status])
  @@index([dueAt])
  @@index([reminderAt])
  @@map("tasks")
}

// ----------------------------------------------------
// NOTIFICATIONS & ANNOUNCEMENTS
// ----------------------------------------------------

model Notification {
  id              String                      @id @default(uuid()) @db.Char(36)
  type            String                      @db.VarChar(100)
  title           String                      @db.VarChar(255)
  body            String                      @db.Text
  deliveryChannel NotificationDeliveryChannel @default(in_app) @map("delivery_channel")
  metadata        Json?
  createdAt       DateTime                    @default(now()) @map("created_at") @db.DateTime(3)

  deliveries NotificationDelivery[]

  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationDelivery {
  id             String         @id @default(uuid()) @db.Char(36)
  notificationId String         @map("notification_id") @db.Char(36)
  recipientId    String         @map("recipient_id") @db.Char(36)
  readAt         DateTime?      @map("read_at") @db.DateTime(3)
  deliveredAt    DateTime?      @map("delivered_at") @db.DateTime(3)
  deliveryStatus DeliveryStatus @default(pending) @map("delivery_status")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  recipient    User         @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt])
  @@index([deliveryStatus])
  @@map("notification_deliveries")
}

model NotificationPreference {
  id               String  @id @default(uuid()) @db.Char(36)
  userId           String  @map("user_id") @db.Char(36)
  notificationType String  @map("notification_type") @db.VarChar(100)
  channelEmail     Boolean @default(true) @map("channel_email")
  channelInApp     Boolean @default(true) @map("channel_in_app")
  isEssential      Boolean @default(false) @map("is_essential")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationType])
  @@index([userId])
  @@map("notification_preferences")
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  endpoint  String   @db.VarChar(1024)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model Announcement {
  id          String    @id @default(uuid()) @db.Char(36)
  title       String    @db.VarChar(255)
  body        String    @db.MediumText
  targetRoles Json?     @map("target_roles") // aspiring_entrepreneur, founder, mentor
  expiresAt   DateTime? @map("expires_at") @db.DateTime(3)
  createdBy   String    @map("created_by") @db.Char(36)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([expiresAt])
  @@index([createdAt])
  @@map("announcements")
}

// ----------------------------------------------------
// GOVERNANCE, AUDIT, REPORTS & RESTRICTIONS
// ----------------------------------------------------

model ContentReport {
  id             String               @id @default(uuid()) @db.Char(36)
  reporterId     String               @map("reporter_id") @db.Char(36)
  targetType     ReportTargetType     @map("target_type")
  targetId       String               @map("target_id") @db.Char(36)
  reasonCategory ReportReasonCategory @map("reason_category")
  reasonDetail   String?              @map("reason_detail") @db.Text
  status         ReportStatus         @default(pending)
  resolvedBy     String?              @map("resolved_by") @db.Char(36)
  resolvedAt     DateTime?            @map("resolved_at") @db.DateTime(3)
  resolutionNotes String?             @map("resolution_notes") @db.Text
  createdAt      DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.DateTime(3)

  reporter User  @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolver User? @relation("ReportResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([status])
  @@index([reporterId])
  @@map("content_reports")
}

model Restriction {
  id         String          @id @default(uuid()) @db.Char(36)
  userId     String          @map("user_id") @db.Char(36)
  type       RestrictionType
  reason     String          @db.Text
  issuedBy   String          @map("issued_by") @db.Char(36)
  issuedAt   DateTime        @default(now()) @map("issued_at") @db.DateTime(3)
  expiresAt  DateTime?       @map("expires_at") @db.DateTime(3)
  resolvedAt DateTime?       @map("resolved_at") @db.DateTime(3)
  resolvedBy String?         @map("resolved_by") @db.Char(36)

  user   User  @relation("UserRestrictions", fields: [userId], references: [id], onDelete: Cascade)
  issuer User  @relation("AdminRestrictions", fields: [issuedBy], references: [id], onDelete: Cascade)
  resolver User? @relation("RestrictionResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([expiresAt])
  @@map("restrictions")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Char(36)
  actorId    String?  @map("actor_id") @db.Char(36)
  action     String   @db.VarChar(100)
  targetType String   @map("target_type") @db.VarChar(100)
  targetId   String?  @map("target_id") @db.Char(36)
  reason     String?  @db.Text
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  metadata   Json?
  timestamp  DateTime @default(now()) @db.DateTime(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([timestamp])
  @@map("audit_logs")
}

model InviteLink {
  id               String       @id @default(uuid()) @db.Char(36)
  email            String       @db.VarChar(255)
  name             String?      @db.VarChar(255)
  preApprovedRole  UserRole     @default(founder) @map("pre_approved_role")
  tokenHash        String       @unique @map("token_hash") @db.VarChar(64)
  status           InviteStatus @default(pending)
  registeredUserId String?      @map("registered_user_id") @db.Char(36)
  createdAt        DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt        DateTime     @map("expires_at") @db.DateTime(3)
  usedAt           DateTime?    @map("used_at") @db.DateTime(3)

  registeredUser User? @relation("InviteRegisteredUser", fields: [registeredUserId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@map("invite_links")
}

model BlacklistIdentifier {
  id             String   @id @default(uuid()) @db.Char(36)
  identifierHash String   @unique @map("identifier_hash") @db.VarChar(64)
  type           String   @db.VarChar(20) // email | phone
  reason         String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([identifierHash])
  @@map("blacklist_identifiers")
}

model GrievanceCase {
  id          String   @id @default(uuid()) @db.Char(36)
  caseId      String   @unique @map("case_id") @db.VarChar(50) // OASIS-GRV-YYYY-XXXX
  submitterId String?  @map("submitter_id") @db.Char(36)
  email       String   @db.VarChar(255)
  category    String   @db.VarChar(50)
  subject     String   @db.VarChar(255)
  message     String   @db.MediumText
  status      String   @default("open") @db.VarChar(50)
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([caseId])
  @@index([status])
  @@index([createdAt])
  @@map("grievance_cases")
}

// ----------------------------------------------------
// PLATFORM SETTINGS, JOBS, STORAGE & LOGS
// ----------------------------------------------------

model Setting {
  id        String   @id @default(uuid()) @db.Char(36)
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("settings")
}

model Job {
  id        String    @id @default(uuid()) @db.Char(36)
  type      String    @db.VarChar(100)
  payload   Json
  status    JobStatus @default(pending)
  attempts  Int       @default(0)
  runAt     DateTime  @default(now()) @map("run_at") @db.DateTime(3)
  lockedAt  DateTime? @map("locked_at") @db.DateTime(3)
  lockedBy  String?   @map("locked_by") @db.VarChar(100)
  error     String?   @db.Text
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([status, runAt])
  @@map("jobs")
}

model EmailOutbox {
  id           String         @id @default(uuid()) @db.Char(36)
  to           String         @db.VarChar(255)
  subject      String         @db.VarChar(255)
  htmlBody     String         @map("html_body") @db.MediumText
  textBody     String?        @map("text_body") @db.MediumText
  status       DeliveryStatus @default(pending)
  attempts     Int            @default(0)
  errorMessage String?        @map("error_message") @db.Text
  sentAt       DateTime?      @map("sent_at") @db.DateTime(3)
  createdAt    DateTime       @default(now()) @map("created_at") @db.DateTime(3)

  @@index([status])
  @@map("email_outbox")
}

model UploadedFile {
  id           String         @id @default(uuid()) @db.Char(36)
  ownerId      String?        @map("owner_id") @db.Char(36)
  purpose      FilePurpose
  filename     String         @db.VarChar(255)
  storageKey   String         @map("storage_key") @db.VarChar(512)
  mimeType     String         @map("mime_type") @db.VarChar(100)
  sizeBytes    Int            @map("size_bytes")
  sha256       String         @db.VarChar(64)
  scanStatus   FileScanStatus @default(pending) @map("scan_status")
  status       String         @default("pending") @db.VarChar(50) // pending | attached | deleted
  createdAt    DateTime       @default(now()) @map("created_at") @db.DateTime(3)

  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([storageKey])
  @@index([status, createdAt])
  @@map("uploaded_files")
}

model DataExportRequest {
  id          String    @id @default(uuid()) @db.Char(36)
  userId      String    @map("user_id") @db.Char(36)
  status      String    @default("pending") @db.VarChar(50) // pending | processing | ready | expired | failed
  fileUrl     String?   @map("file_url") @db.VarChar(1024)
  storageKey  String?   @map("storage_key") @db.VarChar(512)
  expiresAt   DateTime? @map("expires_at") @db.DateTime(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("data_export_requests")
}

model DeletionRequest {
  id          String    @id @default(uuid()) @db.Char(36)
  userId      String    @map("user_id") @db.Char(36)
  status      String    @default("pending") @db.VarChar(50) // pending | scheduled | completed
  scheduledFor DateTime @map("scheduled_for") @db.DateTime(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("deletion_requests")
}

model SearchLog {
  id          String   @id @default(uuid()) @db.Char(36)
  query       String   @db.VarChar(255)
  zeroResults Boolean  @default(false) @map("zero_results")
  resultCount Int      @default(0) @map("result_count")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([query])
  @@index([createdAt])
  @@map("search_logs")
}

model SearchSynonym {
  id        String   @id @default(uuid()) @db.Char(36)
  term      String   @unique @db.VarChar(100)
  synonyms  Json     // array of strings
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@map("search_synonyms")
}

model AnalyticsEvent {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String?  @map("user_id") @db.Char(36)
  name      String   @db.VarChar(100)
  props     Json?
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([name, createdAt])
  @@map("analytics_events")
}
