# Database (MySQL 8)
DATABASE_URL="mysql://user:password@host:3306/Oasis"

# Google OAuth
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_CALLBACK_URL="https://back.oasisodisha.in/api/v1/auth/google/callback"

# App & Environment
NODE_ENV=production
PORT=7500
FRONTEND_URL="https://oasisodisha.in"
WS_ALLOWED_ORIGINS="https://oasisodisha.in,https://www.oasisodisha.in,http://localhost:7200,http://localhost:3000"
COOKIE_DOMAIN=".oasisodisha.in"
TRUST_PROXY=1

# Cryptographic Keys (generate with openssl rand -hex 32)
SESSION_SECRET="change-this-to-a-secure-random-hex-string-32-bytes"
FIELD_ENCRYPTION_KEY="change-this-to-a-secure-random-hex-string-32-bytes"
ADMIN_SETUP_TOKEN="change-this-to-a-secure-random-hex-string-16-bytes"

# Email
MAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="OASIS ONE <no-reply@oasisodisha.in>"
GRIEVANCE_EMAIL="grievance@oasisodisha.in"
OVERSIGHT_EMAIL="oversight@oasisodisha.in"
EMAIL_LOGO_URL="https://oasisodisha.in/brand/oasis-logo-email.png"

# File Storage (local | s3)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false
S3_SSE=AES256
S3_KMS_KEY_ID=
S3_PRESIGN_TTL_SECONDS=120

# Optional services
CLAMAV_HOST=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
SMS_PROVIDER=console
SMS_API_KEY=
REDIS_URL=
SENTRY_DSN=
TEST_DATABASE_URL=
